{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://landintel.vercel.app",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "expose_headers": [
        "Accept-Ranges",
        "Content-Length",
        "Content-Range",
        "Content-Type",
        "Cache-Control",
        "ETag",
        "Last-Modified"
      ],
      "max_age_seconds": 3600
    }
  ]
}
